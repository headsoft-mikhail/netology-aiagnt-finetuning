.DS_Store
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.ty_cache/

# Базовая модель скачивается локально. В Git добавляется только итоговый adapter.
data/models/*
!data/models/adapters/
data/models/adapters/*
!data/models/adapters/lora-tuned-Qwen2.5-0.5B-Instruct/
!data/models/adapters/lora-tuned-Qwen2.5-0.5B-Instruct/**

# В Git хранится только checkpoint итогового учебного запуска.
data/fine_tuning/runs/*
!data/fine_tuning/runs/lora-tuned-Qwen2.5-0.5B-Instruct/
!data/fine_tuning/runs/lora-tuned-Qwen2.5-0.5B-Instruct/checkpoint-16/
!data/fine_tuning/runs/lora-tuned-Qwen2.5-0.5B-Instruct/checkpoint-16/**
